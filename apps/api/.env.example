# Copy to apps/api/.env; never commit real credentials.
AUTH_ENABLED=true
BETTER_AUTH_URL=http://127.0.0.1:5173
# Generate privately: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Generate each outbox key privately with Node crypto.randomBytes(32).toString('base64url').
# Keep previous key versions until every pending encrypted message expires.
OUTBOX_ENCRYPTION_ACTIVE_KEY_ID=v1
OUTBOX_ENCRYPTION_KEYS=
# Set both passwords privately. The migration operator must differ from runtime.
DATABASE_URL=postgres://identity_runtime:CHANGE_ME@127.0.0.1:5432/enterprise_ai_os
BUSINESS_DATABASE_URL=postgres://business_runtime:CHANGE_ME_DIFFERENT_PASSWORD@127.0.0.1:5432/enterprise_ai_os
# Trust only the exact deployment reverse-proxy IPs/CIDRs; empty by default.
# TRUSTED_PROXIES=127.0.0.1
# Put MIGRATION_DATABASE_URL in .env.migration, not this runtime file.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Enterprise AI OS <no-reply@example.test>
# Production SMTP when required:
# SMTP_USER=
# SMTP_PASSWORD=
