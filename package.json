{
  "name": "enterprise-ai-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @enterprise/web --filter @enterprise/api dev",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "pnpm -r build",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm smoke",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "auth:migrate": "pnpm --filter @enterprise/api auth:migrate",
    "auth:invite": "pnpm --filter @enterprise/api auth:invite",
    "auth:services": "docker compose up -d --wait postgres mailpit",
    "test:auth": "vitest run --config vitest.auth.config.ts",
    "test:auth:e2e": "AUTH_LIVE_TEST=true playwright test tests/e2e/auth-live.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "4.0.18"
  }
}
